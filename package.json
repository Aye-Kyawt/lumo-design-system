{
  "name": "@ds-house/lumo-design-system",
  "version": "0.1.0",
  "description": "Lumo Design System \u2014 React components built from Figma, styled only from generated tokens.",
  "license": "ISC",
  "author": "",
  "keywords": [],
  "type": "module",
  "//private": "Guard, not a mistake. A stray `npm publish` is refused. scripts/release-publish.js is the one command allowed to lift it, and it puts it straight back.",
  "private": true,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:tokens": "node build-tokens.js",
    "build:lib": "tsup",
    "build:css": "node scripts/build-css.js",
    "build:package": "npm run build:tokens && npm run build:lib && npm run build:css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build:package && npm test",
    "release:publish": "node scripts/release-publish.js",
    "storybook": "npm run build:tokens && storybook dev -p 6006",
    "build:storybook": "npm run build:tokens && storybook build -o storybook-static"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
