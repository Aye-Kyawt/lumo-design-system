node_modules/
.DS_Store

# Generated on every build — see build-tokens.js
/.tokens-clean/
/build/
/storybook-static/

# The published library build, produced by build:package.
/dist/

# QA run artifacts. Regenerated every test pass, so a committed set goes stale
# the moment the component is fixed -- as happened on PR #7.
/reports/

# Registry IDs are a local decision. See .claude/registry.local.json.example
.claude/registry.local.json

# Isolated worktrees created for background agents. Each carries its own
# node_modules, so this directory runs to hundreds of megabytes.
.claude/worktrees/
